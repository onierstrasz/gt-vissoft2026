Object subclass: #VSStudy	instanceVariableNames: 'allPapers selectedPapers authors topics'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:56'!allPapers	^ allPapers! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:56'!authorNamed: aName	^ authors		at: aName		ifAbsentPut: [ VSAuthor new			name: aName;			yourself ]! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:56'!authors	^ authors! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:56'!paperAt: anId	^ allPapers at: anId! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:56'!selectedPapers	^ selectedPapers! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:56'!topicNamed: aName	^ topics		at: aName		ifAbsentPut: [ VSTopic new			name: aName;			yourself ]! !!VSStudy methodsFor: 'accessing' stamp: '9/2/2026 15:56'!topics	^ topics! !!VSStudy methodsFor: 'visualizing' stamp: '9/2/2026 15:56'!initialsForAuthor: anAuthor	"Answer initials for author names formatted as 'Surname, Given names'."	| nameParts surname givenNames givenLetters surnameLetters |	nameParts := anAuthor name substrings: ','.	surname := nameParts first ifNil: [ '' ].	givenNames := nameParts allButFirst joinUsing: ' '.	givenLetters := givenNames select: #isLetter.	surnameLetters := surname select: #isLetter.	^ (givenLetters		ifEmpty: [ '' ]		ifNotEmpty: [ givenLetters first asString ])		, (surnameLetters			ifEmpty: [ '' ]			ifNotEmpty: [ surnameLetters first asString ])! !!VSStudy methodsFor: 'gt views' stamp: '9/2/2026 15:56'!gtAuthorsFor: aView	<gtView>	^ aView columnedList		title: 'Authors';		priority: 3;		items: [ self authors values asSortedCollection: [ :anAuthor :anotherAuthor | anAuthor name < anotherAuthor name ] ];		column: 'Author' text: [ :anAuthor | anAuthor name ] weight: 2;		column: '# of papers' text: [ :anAuthor | anAuthor papers size ] weight: 0.6;		send: [ :anAuthor | anAuthor ];		actionUpdateButton! !!VSStudy methodsFor: 'gt views' stamp: '9/2/2026 15:56'!gtPapersFor: aView	<gtView>	^ aView columnedList		title: 'Papers';		priority: 1;		items: [ (allPapers values			sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])			withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ] ];		column: '#' text: [ :anAssociation | anAssociation key ] weight: 0.3;		column: 'ID' text: [ :anAssociation | anAssociation value id ] weight: 0.4;		column: 'Title' text: [ :anAssociation | anAssociation value record at: 'Title' ] weight: 4;		column: 'Type' text: [ :anAssociation | anAssociation value record at: 'Type' ] weight: 0.8;		column: '# of Authors' text: [ :anAssociation | anAssociation value authorNames size ] weight: 0.6;		column: 'Year' text: [ :anAssociation | anAssociation value record at: 'Year' ] weight: 0.5;		column: 'First author' text: [ :anAssociation | anAssociation value authorNames at: 1 ifAbsent: [ '' ] ] weight: 1.5;		column: 'Second author' text: [ :anAssociation | anAssociation value authorNames at: 2 ifAbsent: [ '' ] ] weight: 1.5;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'gt views' stamp: '9/2/2026 15:56'!gtSelectedPapersFor: aView	<gtView>	^ aView columnedList		title: 'Selected Papers';		priority: 2;		items: [ ((allPapers values select: [ :aPaper | aPaper isDesignStudy and: [ aPaper selectedRecord notNil ] ])			sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])			withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ] ];		column: '#' text: [ :anAssociation | anAssociation key ] weight: 0.3;		column: 'ID' text: [ :anAssociation | anAssociation value id ] weight: 0.4;		column: 'Title' text: [ :anAssociation | anAssociation value record at: 'Title' ] weight: 4;		column: 'Type' text: [ :anAssociation | anAssociation value record at: 'Type' ] weight: 0.8;		column: 'Topic' text: [ :anAssociation | anAssociation value topicName ifNil: [ '' ] ] weight: 1;		column: '# of Authors' text: [ :anAssociation | anAssociation value authorNames size ] weight: 0.6;		column: 'Year' text: [ :anAssociation | anAssociation value record at: 'Year' ] weight: 0.5;		column: 'First author' text: [ :anAssociation | anAssociation value authorNames at: 1 ifAbsent: [ '' ] ] weight: 1.5;		column: 'Second author' text: [ :anAssociation | anAssociation value authorNames at: 2 ifAbsent: [ '' ] ] weight: 1.5;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'views' stamp: '9/2/2026 15:56'!gtPaperCountsByYearFor: aView	<gtView>	^ aView explicit		title: 'Papers by year';		priority: 2.3;		stencil: [ self paperCountsByYearChart asElement ];		actionUpdateButton! !!VSStudy methodsFor: 'views' stamp: '9/2/2026 15:56'!gtPaperGroupsByYearFor: aView	<gtView>	^ aView columnedList		title: 'Paper groups by year';		priority: 2.1;		items: [			((VSPaperGroup withAll: allPapers values)				groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ]) associations				sorted: [ :anAssociation :anotherAssociation | anAssociation key < anotherAssociation key ] ];		column: 'Year' text: [ :anAssociation | anAssociation key ];		column: '# of papers' text: [ :anAssociation | anAssociation value size ];		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'views' stamp: '9/2/2026 15:56'!gtSelectedPaperGroupsByYearFor: aView	<gtView>	^ aView columnedList		title: 'Selected paper groups by year';		priority: 2.2;		items: [			((VSPaperGroup withAll: (allPapers values select: [ :aPaper | aPaper selectedRecord notNil ]))				groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ]) associations				sorted: [ :anAssociation :anotherAssociation | anAssociation key < anotherAssociation key ] ];		column: 'Year' text: [ :anAssociation | anAssociation key ];		column: '# of papers' text: [ :anAssociation | anAssociation value size ];		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSStudy methodsFor: 'gt-search' stamp: '9/2/2026 15:56'!gtSpotterForPaperTitles: aSearch	<gtSearch>	^ aSearch list		title: 'Paper titles';		priority: 10;		items: [ self allPapers values ];		itemsLimit: Float infinity;		itemName: [ :aPaper | aPaper record at: 'Title' ];		sendCategory: [ :aCategory :aStep :thisSearch |			VSPaperGroup withAll: aCategory items contents asArray ];		filterBySubstring! !!VSStudy methodsFor: 'initialization' stamp: '9/2/2026 15:56'!initialize	super initialize.	self loadFromResources! !!VSStudy methodsFor: 'initialization' stamp: '9/2/2026 15:56'!loadFromResources	| dataFolder allPaperRecords selectedPapersById |	dataFolder := FileLocator gtResource / 'onierstrasz' / 'gt-vissoft2026' / 'data'.	allPaperRecords := (CSV2JSON for: (dataFolder / 'dataset-review-vissoft-all.csv') contents) jsonObject.	selectedPapers := (CSV2JSON for: (dataFolder / 'dataset-review-vissoft-selected.csv') contents) jsonObject.	selectedPapersById := Dictionary new.	selectedPapers do: [ :each | selectedPapersById at: (each at: 'ID') put: each ].	allPapers := Dictionary new.	authors := Dictionary new.	topics := Dictionary new.	allPaperRecords do: [ :each |		| paper |		paper := VSPaper new			study: self;			record: each;			yourself.		paper isDesignStudy ifTrue: [			paper selectedRecord: (selectedPapersById at: paper id ifAbsent: [ nil ]) ].		paper authorNames do: [ :eachName | (self authorNamed: eachName) addPaper: paper ].		paper topic ifNotNil: [ :aTopic | aTopic addPaper: paper ].		allPapers at: paper id put: paper ].	^ self! !!VSStudy methodsFor: 'charting' stamp: '9/2/2026 15:56'!paperCountsByYearChart	| years data maximumCount widthScale heightScale chart |	years := (allPapers values collect: [ :aPaper | aPaper record at: 'Paper Year' ]) asSet		asSortedCollection.	data := GtPlotterDataGroup new values: (years flatCollect: [ :aYear |		{			{ aYear. false. self papersInYear: aYear selectedOnly: false }.			{ aYear. true. self papersInYear: aYear selectedOnly: true } } ]).	data := data		groupedBy: [ :each | each first ]		sorted: [ :a :b | a key < b key ]		labelled: #yourself.	data := data		groupedBy: [ :each | each second ]		sorted: [ :a :b | a key not ]		colored: [ :isSelected |			isSelected				ifTrue: [ Color r: 244 g: 204 b: 204 range: 255 ]				ifFalse: [ Color r: 173 g: 216 b: 230 range: 255 ] ].	maximumCount := data inject: 0 intoValues: [ :maximum :each |		maximum max: each third size ].	widthScale := GtPlotterLinearScale new domainFrom: 0 to: maximumCount.	heightScale := GtPlotterLinearScale new		domainFrom: 0 to: data size;		rangeFrom: 10 to: 30.	chart := GtPlotterHorizontalBarChart new.	chart		withAdjacentBars;		groupSpacing: 5;		barLabelSpacing: 55;		barWidthScale: widthScale;		barWidthData: [ :each | each third size ];		barHeightScale: heightScale;		barHeightData: [ :eachGroup | eachGroup size ];		amountOfTicks: 4;		barGroupStencil: [ :aBar :aGroup :aContext |			(aBar stencil scaleContext: aContext) asElement				constraintsDo: [ :c |					c horizontal matchParent.					c vertical exact: (aBar heightScale map: (aBar heightData cull: aGroup)) ];				when: BlClickEvent do: [ :anEvent |					anEvent consumed: true.					anEvent currentTarget phlow						spawnObject: (self paperGroupFromPlotterDataEntity: aContext originalValue) ];				geometry: (BlHistogramGeometry new beLeftToRight values: aContext mappedValue);				background: aGroup color ];		with: data.	^ chart! !!VSStudy methodsFor: 'charting' stamp: '9/2/2026 15:56'!paperGroupFromPlotterDataEntity: aDataEntity	"Extract the paper group from a plotter group, removing its presentation decorators."	^ aDataEntity decoratedEntity values first third! !!VSStudy methodsFor: 'querying' stamp: '9/2/2026 15:56'!papersInYear: aYear selectedOnly: aBoolean	| papers |	papers := allPapers values select: [ :each |		(each record at: 'Paper Year') = aYear asString ].	aBoolean ifTrue: [		papers := papers select: [ :each | each selectedRecord notNil ] ].	^ VSPaperGroup withAll: papers! !!VSStudy methodsFor: 'searching' stamp: '9/2/2026 15:56'!papersMatchingTitle: aQueryString	| query |	query := aQueryString asLowercase.	^ VSPaperGroup withAll: ((allPapers values select: [ :aPaper |		(aPaper record at: 'Title') asLowercase includesSubstring: query ])		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])! !Object subclass: #VSAuthor	instanceVariableNames: 'name papers'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSAuthor commentStamp: '' prior: 0!An author participating in one or more papers in a visual software study.!!VSAuthor methodsFor: 'adding' stamp: '9/2/2026 15:56'!addPaper: aVSPaper	papers addIfNotPresent: aVSPaper! !!VSAuthor methodsFor: 'gt views' stamp: '9/2/2026 15:56'!gtPapersFor: aView	<gtView>	^ aView columnedList		title: 'Papers';		items: [ (self papers			sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ])			withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ] ];		column: '#' text: [ :anAssociation | anAssociation key ] weight: 0.3;		column: 'ID' text: [ :anAssociation | anAssociation value id ] weight: 0.4;		column: 'Title' text: [ :anAssociation | anAssociation value record at: 'Title' ] weight: 4;		column: 'Type' text: [ :anAssociation | anAssociation value record at: 'Type' ] weight: 0.8;		column: '# of Authors' text: [ :anAssociation | anAssociation value authorNames size ] weight: 0.6;		column: 'Year' text: [ :anAssociation | anAssociation value record at: 'Year' ] weight: 0.5;		column: 'First author' text: [ :anAssociation | anAssociation value authorNames at: 1 ifAbsent: [ '' ] ] weight: 1.5;		column: 'Second author' text: [ :anAssociation | anAssociation value authorNames at: 2 ifAbsent: [ '' ] ] weight: 1.5;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSAuthor methodsFor: 'initialization' stamp: '9/2/2026 15:56'!initialize	super initialize.	papers := OrderedCollection new! !!VSAuthor methodsFor: 'accessing' stamp: '9/2/2026 15:56'!name	^ name! !!VSAuthor methodsFor: 'accessing' stamp: '9/2/2026 15:56'!name: aString	name := aString! !!VSAuthor methodsFor: 'accessing' stamp: '9/2/2026 15:56'!papers	^ papers! !!VSAuthor methodsFor: 'printing' stamp: '9/2/2026 15:56'!printOn: aStream	aStream nextPutAll: self name! !Object subclass: #VSPaperGroup	uses: TGtGroupWithItems	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Model'!!VSPaperGroup commentStamp: '' prior: 0!A moldable collection wrapper for papers in a visualization study.!!VSPaperGroup methodsFor: 'gt-views' stamp: '9/2/2026 15:56'!gtPaperGroupsByYearFor: aView	<gtView>	^ aView columnedList		title: 'Paper groups by year';		priority: 1.1;		items: [			(self groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ]) associations				sorted: [ :anAssociation :anotherAssociation | anAssociation key < anotherAssociation key ] ];		column: 'Year' text: [ :anAssociation | anAssociation key ];		column: '# of papers' text: [ :anAssociation | anAssociation value size ];		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSPaperGroup methodsFor: 'gt-views' stamp: '9/2/2026 15:56'!gtPapersFor: aView	<gtView>	^ aView columnedList		title: 'Papers';		priority: 1;		items: [ self items			withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ] ];		column: '#' text: [ :anAssociation | anAssociation key ] weight: 0.3;		column: 'ID' text: [ :anAssociation | anAssociation value id ] weight: 0.4;		column: 'Title' text: [ :anAssociation | anAssociation value record at: 'Title' ] weight: 4;		column: 'Type' text: [ :anAssociation | anAssociation value record at: 'Type' ] weight: 0.8;		column: '# of Authors' text: [ :anAssociation | anAssociation value authorNames size ] weight: 0.6;		column: 'Year' text: [ :anAssociation | anAssociation value record at: 'Year' ] weight: 0.5;		column: 'First author' text: [ :anAssociation | anAssociation value authorNames at: 1 ifAbsent: [ '' ] ] weight: 1.5;		column: 'Second author' text: [ :anAssociation | anAssociation value authorNames at: 2 ifAbsent: [ '' ] ] weight: 1.5;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !"-- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- -- "!VSPaperGroup class	uses: TGtGroupWithItems classTrait	instanceVariableNames: ''!!VSPaperGroup class commentStamp: '' prior: 0!A moldable collection wrapper for papers in a visualization study.!Object subclass: #VSTopic	instanceVariableNames: 'name papers'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSTopic methodsFor: 'adding' stamp: '9/2/2026 15:56'!addPaper: aVSPaper	papers addIfNotPresent: aVSPaper! !!VSTopic methodsFor: 'initialization' stamp: '9/2/2026 15:56'!initialize	super initialize.	papers := OrderedCollection new! !!VSTopic methodsFor: 'accessing' stamp: '9/2/2026 15:56'!name	^ name! !!VSTopic methodsFor: 'accessing' stamp: '9/2/2026 15:56'!name: aString	name := aString! !!VSTopic methodsFor: 'accessing' stamp: '9/2/2026 15:56'!papers	^ papers! !!VSTopic methodsFor: 'printing' stamp: '9/2/2026 15:56'!printOn: aStream	aStream nextPutAll: self name! !Object subclass: #VSPaper	instanceVariableNames: 'record study selectedRecord'	classVariableNames: ''	package: 'VISSOFT-Model'!!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!authorNames	| authorKeys |	authorKeys := #(		'First Author'		'Second Author'		'Third Author'		'Fourth Author'		'Fifth Author'		'Sixth Author'		'Seven Author'		'Eighth Author'		'Nineth Author'		'Tenth Author'		'Eleventh Author'		'Twelfth Author').	^ (authorKeys collect: [ :aKey |		(record at: aKey ifAbsent: [ '' ]) copyWithout: $" ])		collect: [ :aName | aName trimBoth ]		thenSelect: [ :aName | aName isNotEmpty ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!authors	^ self authorNames collect: [ :eachName | study authorNamed: eachName ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!googleScholarSearchUrl	^ 'https://scholar.google.com/scholar?hl=en&q=' , (record at: 'Title') urlEncoded! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!id	^ record at: 'ID'! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!record	^ record! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!record: aDictionary	record := aDictionary! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!selectedRecord	^ selectedRecord! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!selectedRecord: aDictionary	selectedRecord := aDictionary! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!study	^ study! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!study: aVSStudy	study := aVSStudy! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!title	"Answer the paper title from the source record."	^ record at: 'Title' ifAbsent: [ '' ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!topic	^ self topicName		ifNil: [ nil ]		ifNotNil: [ :aName | study topicNamed: aName ]! !!VSPaper methodsFor: 'accessing' stamp: '9/2/2026 15:56'!topicName	^ selectedRecord		ifNil: [ nil ]		ifNotNil: [ selectedRecord at: 'Topic' ifAbsent: [ nil ] ]! !!VSPaper methodsFor: 'visualizing' stamp: '9/2/2026 15:56'!reachablePaperAuthorComponent	"Answer papers -> authors in the connected paper-author component containing this paper."	| papers authors pendingPapers aPaper |	papers := IdentitySet with: self.	authors := IdentitySet new.	pendingPapers := OrderedCollection with: self.	[ pendingPapers isEmpty ] whileFalse: [		aPaper := pendingPapers removeFirst.		aPaper authors do: [ :anAuthor |			authors add: anAuthor.			anAuthor papers do: [ :anotherPaper |				(papers includes: anotherPaper) ifFalse: [					papers add: anotherPaper.					pendingPapers add: anotherPaper ] ] ] ].	^ papers -> authors! !!VSPaper methodsFor: 'gt views' stamp: '9/2/2026 15:56'!gtAuthorsFor: aView	<gtView>	^ aView columnedList		title: 'Authors';		priority: 1;		items: [ self authors ];		column: 'Author' text: [ :anAuthor | anAuthor name ] weight: 2;		column: '# of papers' text: [ :anAuthor | anAuthor papers size ] weight: 0.6;		send: [ :anAuthor | anAuthor ];		actionUpdateButton! !!VSPaper methodsFor: 'gt views' stamp: '9/2/2026 15:56'!gtStudyDetailsFor: aView	<gtView>	selectedRecord ifNil: [ ^ aView empty ].	^ aView columnedList		title: 'Study Details';		priority: 3;		items: [ selectedRecord associations sorted: [ :left :right | left key <= right key ] ];		column: 'Attribute' text: [ :anAssociation | anAssociation key ] weight: 1;		column: 'Value' text: [ :anAssociation | anAssociation value ] weight: 4;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSPaper methodsFor: 'gt views' stamp: '9/2/2026 15:56'!gtSummaryFor: aView	<gtView>	^ aView columnedList		title: 'Summary';		priority: 2;		items: [			| authorKeys otherKeys orderedKeys |			authorKeys := #('First Author' 'Second Author' 'Third Author' 'Fourth Author' 'Fifth Author' 'Sixth Author' 'Seven Author' 'Eighth Author' 'Nineth Author' 'Tenth Author' 'Eleventh Author' 'Twelfth Author').			otherKeys := record keys reject: [ :aKey |				(aKey allSatisfy: [ :aCharacter | aCharacter isDigit ])					or: [ aKey = 'Title' or: [ authorKeys includes: aKey ] ] ].			orderedKeys := { 'Title' }, (authorKeys select: [ :aKey | record includesKey: aKey ]), otherKeys asSortedCollection.			orderedKeys collect: [ :aKey | aKey -> (record at: aKey) ] ];		column: 'Attribute' text: [ :anAssociation | anAssociation key ] weight: 1;		column: 'Value' text: [ :anAssociation | anAssociation value ] weight: 4;		send: [ :anAssociation | anAssociation value ];		actionUpdateButton! !!VSPaper methodsFor: 'gt-actions' stamp: '9/2/2026 15:56'!gtGoogleScholarSearchFor: anAction	<gtAction>	^ anAction button		icon: BrGlamorousVectorIcons web;		tooltip: 'Search title in Google Scholar';		action: [ :aButton | WebBrowser openOn: self googleScholarSearchUrl ]! !!VSPaper methodsFor: 'testing' stamp: '9/2/2026 15:56'!isDesignStudy	^ (record at: 'Type' ifAbsent: [ nil ]) = 'Design Study'! !!VSPaper methodsFor: 'printing' stamp: '9/2/2026 15:56'!printOn: aStream	aStream nextPutAll: (record at: 'Title')! !Object subclass: #VSStudyExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!authorsAreListedByName	<gtExample>	| aStudy authors |	aStudy := self study.	authors := aStudy authors values asSortedCollection: [ :anAuthor :anotherAuthor | anAuthor name < anotherAuthor name ].	self assert: authors size equals: aStudy authors size.	self assert: (authors allSatisfy: [ :anAuthor | anAuthor isKindOf: VSAuthor ]).	self assert: (authors allSatisfy: [ :anAuthor | anAuthor papers isNotEmpty ]).	^ aStudy! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperAuthorCounts	<gtExample>	| aStudy papers |	aStudy := self study.	papers := aStudy allPapers values.	self assert: (papers allSatisfy: [ :aPaper | aPaper authorNames size >= 0 ]).	self assert: (papers anySatisfy: [ :aPaper | aPaper authorNames size > 1 ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperGroupGroupsPapersByYear	<gtExample>	| paperGroup groups |	paperGroup := VSPaperGroup withAll: self study allPapers values.	groups := paperGroup groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ].	self assert: (groups at: '2015') class equals: VSPaperGroup.	self assert: (groups at: '2015') size equals: 31.	self assert: (groups values inject: 0 into: [ :sum :each | sum + each size ]) equals: paperGroup size.	^ groups! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!papersAreNumberedAndSortedById	<gtExample>	| aStudy papers |	aStudy := self study.	papers := aStudy allPapers values		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ].	self assert: papers first id equals: '1'.	self assert: papers size equals: aStudy allPapers size.	self assert: (papers withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ]) first key equals: 1.	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!papersMatchingTitleReturnsAPaperGroup	<gtExample>	| aStudy matches |	aStudy := self study.	matches := aStudy papersMatchingTitle: 'polyptychon'.	self assert: matches class equals: VSPaperGroup.	self assert: matches size equals: 1.	self assert: matches first id equals: '305'.	^ matches! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!papersMatchingTitleReturnsPapersContainingTheQuery	<gtExample>	| aStudy matches |	aStudy := self study.	matches := aStudy papersMatchingTitle: 'polyptychon'.	self assert: matches size equals: 1.	self assert: matches first id equals: '305'.	self assert: (matches first record at: 'Title') equals: 'Polyptychon: A Hierarchically-Constrained Classified Dependencies Visualization'.	^ matches! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!selectedDesignStudyPapers	<gtExample>	| aStudy papers |	aStudy := self study.	papers := aStudy allPapers values select: [ :aPaper | aPaper isDesignStudy and: [ aPaper selectedRecord notNil ] ].	self assert: papers size equals: aStudy selectedPapers size.	self assert: (papers allSatisfy: [ :aPaper | aPaper isDesignStudy ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!selectedPaperTopics	<gtExample>	| papers |	papers := self selectedPapersAreNumberedAndSortedById collect: #value.	self assert: (papers allSatisfy: [ :aPaper | aPaper topicName = (aPaper selectedRecord at: 'Topic' ifAbsent: [ nil ]) ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!selectedPapersAreNumberedAndSortedById	<gtExample>	| aStudy papers |	aStudy := self study.	papers := (aStudy allPapers values select: [ :aPaper | aPaper isDesignStudy and: [ aPaper selectedRecord notNil ] ])		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ].	self assert: papers size equals: aStudy selectedPapers size.	self assert: (papers withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ]) first key equals: 1.	self assert: (papers allSatisfy: [ :aPaper | aPaper isDesignStudy ]).	^ papers! !!VSStudyExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!study	<gtExample>	| aStudy |	aStudy := VSStudy new.	self assert: aStudy allPapers size equals: 346.	self assert: aStudy selectedPapers size equals: 65.	^ aStudy! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!paperCountsByYearChart	<gtExample>	<return: #GtPlotterHorizontalBarChart>	| chart |	chart := self study paperCountsByYearChart.	self assert: chart class equals: GtPlotterHorizontalBarChart.	^ chart! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!paperCountsByYearChartAllBarsMapToPaperGroups	<gtExample>	| study chart paperGroups |	study := self study.	chart := study paperCountsByYearChart.	paperGroups := OrderedCollection new.	(chart instVarNamed: 'data') groupsDo: [ :eachPlotterGroup |		paperGroups add: (study paperGroupFromPlotterDataEntity: eachPlotterGroup) ].	self assert: paperGroups size equals: 24.	self assert: (paperGroups allSatisfy: [ :each | each isKindOf: VSPaperGroup ]).	self assert: (paperGroups select: [ :each | each size = 40 ]) size equals: 1.	^ chart! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!paperCountsByYearChartAllRenderedBarGroupsMapToPaperGroups	<gtExample>	| study chart paperGroups |	study := self study.	chart := study paperCountsByYearChart.	paperGroups := OrderedCollection new.	(chart instVarNamed: 'data') groupsDo: [ :eachPlotterGroup |		paperGroups add: (study paperGroupFromPlotterDataEntity: eachPlotterGroup) ].	self assert: paperGroups size equals: 24.	self assert: (paperGroups allSatisfy: [ :each | each isKindOf: VSPaperGroup ]).	self assert: (paperGroups at: 3) size equals: 40.	^ chart asElement! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!paperCountsByYearChartBarsHavePaperGroups	<gtExample>	| chart data |	chart := self study paperCountsByYearChart.	data := chart instVarNamed: 'data'.	self assert: (data values allSatisfy: [ :each | each third isKindOf: VSPaperGroup ]).	^ chart! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!paperCountsByYearChartBarsRetainPaperGroups	<gtExample>	| chart chartElement |	chart := self study paperCountsByYearChart.	chartElement := chart asElement.	self assert: chartElement children notEmpty.	^ chartElement! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!paperGroupsByYear	<gtExample>	| groups |	groups := (VSPaperGroup withAll: self study allPapers values)		groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ].	self assert: (groups at: '2015') class equals: VSPaperGroup.	self assert: (groups at: '2015') size equals: 31.	self assert: (groups values inject: 0 into: [ :sum :each | sum + each size ]) equals: 346.	^ groups! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!papersInYearReturnsAllPapers	<gtExample>	| papers |	papers := self study papersInYear: 2015 selectedOnly: false.	self assert: papers class equals: VSPaperGroup.	self assert: papers size equals: 31.	self assert: (papers allSatisfy: [ :each | (each record at: 'Paper Year') = '2015' ]).	^ papers! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!papersInYearReturnsSelectedPapers	<gtExample>	| papers |	papers := self study papersInYear: 2015 selectedOnly: true.	self assert: papers class equals: VSPaperGroup.	self assert: papers size equals: 10.	self assert: (papers allSatisfy: [ :each |		(each record at: 'Paper Year') = '2015'			and: [ each selectedRecord notNil ] ]).	^ papers! !!VSStudyExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!selectedPaperGroupsByYear	<gtExample>	| groups |	groups := (VSPaperGroup withAll: (self study allPapers values select: [ :aPaper | aPaper selectedRecord notNil ]))		groupedBy: [ :aPaper | aPaper record at: 'Paper Year' ].	self assert: (groups at: '2015') class equals: VSPaperGroup.	self assert: (groups at: '2015') size equals: 10.	self assert: (groups values inject: 0 into: [ :sum :each | sum + each size ]) equals: 65.	^ groups! !Object subclass: #VSTopicExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSTopicExamples commentStamp: '' prior: 0!Examples for topic relationships in a visual software study.!!VSTopicExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!topicPrintsItsName	<gtExample>	| aStudy aTopic |	aStudy := VSStudy new.	aTopic := aStudy topicNamed: 'Elements'.	self assert: aTopic printString equals: aTopic name.	^ aTopic! !Object subclass: #VSPaperExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!designStudyReceivesSelectedRecord	<gtExample>	| aStudy designStudy |	aStudy := VSStudy new.	designStudy := aStudy allPapers values		detect: [ :each | each isDesignStudy and: [ each selectedRecord notNil ] ].	self		assert: (designStudy selectedRecord at: 'ID')		equals: designStudy id.	^ designStudy! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!nonDesignStudyHasNoStudyDetails	<gtExample>	| aStudy aPaper |	aStudy := VSStudy new.	aPaper := aStudy allPapers values detect: [ :each | each isDesignStudy not ].	self assert: aPaper selectedRecord isNil.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperAuthorNamesFollowAuthorAttributeOrder	<gtExample>	| aPaper |	aPaper := self paperPrintsItsTitle.	self assert: aPaper authorNames first equals: 'Daniel, D.T.'.	self assert: (aPaper authorNames at: 2) equals: 'Wuchner, E.'.	self assert: (aPaper authorNames at: 3) equals: 'Sokolov, K.'.	self assert: (aPaper authorNames at: 4) equals: 'Stal, M.'.	self assert: (aPaper authorNames at: 5) equals: 'Liggesmeyer, P.'.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperAuthorsAreLinkedToAuthorInstances	<gtExample>	| aPaper authors |	aPaper := self paperPrintsItsTitle.	authors := aPaper authors.	self assert: authors size equals: aPaper authorNames size.	self assert: (authors allSatisfy: [ :anAuthor | anAuthor isKindOf: VSAuthor ]).	self assert: (authors allSatisfy: [ :anAuthor | anAuthor papers includes: aPaper ]).	self assert: (authors allSatisfy: [ :anAuthor | anAuthor papers size > 0 ]).	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperGoogleScholarSearchUrlUsesItsTitle	<gtExample>	| aPaper |	aPaper := self designStudyReceivesSelectedRecord.	self		assert: aPaper googleScholarSearchUrl		equals: 'https://scholar.google.com/scholar?hl=en&q=' , (aPaper record at: 'Title') urlEncoded.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperPrintsItsTitle	<gtExample>	| aPaper |	aPaper := self designStudyReceivesSelectedRecord.	self assert: aPaper printString equals: (aPaper record at: 'Title').	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperSummaryContainsAllRecordAttributes	<gtExample>	| aPaper |	aPaper := self paperPrintsItsTitle.	self assert: aPaper record associations size equals: aPaper record keys size.	self assert: (aPaper record includesKey: 'Title').	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!paperSummaryOrdersTitleAndAuthorsAndHidesNumericAttributes	<gtExample>	| aPaper authorKeys otherKeys orderedKeys |	aPaper := self paperPrintsItsTitle.	authorKeys := #(		'First Author'		'Second Author'		'Third Author'		'Fourth Author'		'Fifth Author'		'Sixth Author'		'Seven Author'		'Eighth Author'		'Nineth Author'		'Tenth Author'		'Eleventh Author'		'Twelfth Author').	otherKeys := aPaper record keys reject: [ :aKey |		(aKey allSatisfy: [ :aCharacter | aCharacter isDigit ])			or: [ aKey = 'Title' or: [ authorKeys includes: aKey ] ] ].	orderedKeys := { 'Title' }		, (authorKeys select: [ :aKey | aPaper record includesKey: aKey ])		, otherKeys asSortedCollection.	self assert: orderedKeys first equals: 'Title'.	self assert: (orderedKeys includes: '1') equals: false.	self assert: (orderedKeys indexOf: 'First Author') < (orderedKeys indexOf: 'Second Author').	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!selectedPaperHasStudyDetails	<gtExample>	| aPaper |	aPaper := self designStudyReceivesSelectedRecord.	self assert: aPaper isDesignStudy.	self assert: aPaper selectedRecord isNotNil.	self assert: aPaper selectedRecord associations isNotEmpty.	^ aPaper! !!VSPaperExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!studyCreatesPapersKeyedById	<gtExample>	| aStudy aPaper |	aStudy := VSStudy new.	self assert: aStudy allPapers size equals: 346.	aPaper := aStudy paperAt: '1'.	self assert: aPaper class equals: VSPaper.	self assert: aPaper study equals: aStudy.	self assert: aPaper id equals: '1'.	^ aStudy! !!VSPaperExamples methodsFor: 'Examples' stamp: '9/2/2026 15:56'!paperTitleIsAvailableThroughAnAccessor	<gtExample>	| aPaper |	aPaper := self paperPrintsItsTitle.	self assert: aPaper title equals: (aPaper record at: 'Title').	^ aPaper! !Object subclass: #VSAuthorExamples	instanceVariableNames: ''	classVariableNames: ''	package: 'VISSOFT-Examples'!!VSAuthorExamples commentStamp: '' prior: 0!Examples for the author relationships in a visual software study.!!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!authorPapersAreSortedAndNumbered	<gtExample>	| anAuthor papers |	anAuthor := self studyCreatesUniqueAuthorsAndLinksPapers.	papers := anAuthor papers		sorted: [ :aPaper :anotherPaper | aPaper id asNumber < anotherPaper id asNumber ].	self assert: papers size equals: anAuthor papers size.	self assert: (papers allSatisfy: [ :aPaper | aPaper authors includes: anAuthor ]).	self assert: (papers withIndexCollect: [ :aPaper :anIndex | anIndex -> aPaper ]) first key equals: 1.	^ anAuthor! !!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!authorPrintsItsName	<gtExample>	| anAuthor |	anAuthor := self studyCreatesUniqueAuthorsAndLinksPapers.	self assert: anAuthor printString equals: anAuthor name.	^ anAuthor! !!VSAuthorExamples methodsFor: 'examples' stamp: '9/2/2026 15:56'!studyCreatesUniqueAuthorsAndLinksPapers	<gtExample>	| aStudy aPaper anAuthor |	aStudy := VSStudy new.	aPaper := aStudy paperAt: '1'.	anAuthor := aStudy authorNamed: 'Sajaniemi, J.'.	self assert: anAuthor class equals: VSAuthor.	self assert: (aStudy authorNamed: 'Sajaniemi, J.') equals: anAuthor.	self assert: (aStudy authorNamed: 'Sajaniemi, J.') == anAuthor.	self assert: (anAuthor papers includes: aPaper).	^ anAuthor! !