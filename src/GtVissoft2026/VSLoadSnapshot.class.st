Class {
	#name : 'VSLoadSnapshot',
	#superclass : 'Object',
	#category : 'GtVissoft2026-Examples',
	#package : 'GtVissoft2026',
	#tag : 'Examples'
}

{ #category : 'examples' }
VSLoadSnapshot >> barChartWithoutModel [
	"This is one of the results generated by the following prompt:

chat := GtL chat
		tools: GtLTools gtObjectsExecution;
		sendMarkdown: 'There are two CSV files in the folder returned by `FileLocator gtResource / ''feenkcom/gtoolkit-demos/data/visualisation-review''` describing a dataset of software visualization papers. Analyze the contents and generate a visualization of the evolution of Design Study papers vs other papers over the years.'
"

	<gtExample>
	| rows years designData otherData scale designChart otherChart panel |
	rows := CSVParser
			parseFileWithHeader: FileLocator gtResource
					/ 'feenkcom/gtoolkit-demos/data/visualisation-review/dataset-review-vissoft-all.csv'.
	years := (rows collect: [ :r | (r at: 'Paper Year') asNumber ]) asSet
			asSortedCollection.
	designData := GtPlotterDataGroup new
			values: (years
					collect: [ :year | 
						| rs count |
						rs := rows select: [ :r | (r at: 'Paper Year') asNumber = year ].
						count := rs count: [ :r | (r at: 'Type') = 'Design Study' ].
						{year asString.
							count} ]).
	designData := (designData labelled: #first)
			background: [ :each | Color blue alpha: 0.75 ].
	otherData := GtPlotterDataGroup new
			values: (years
					collect: [ :year | 
						| rs count |
						rs := rows select: [ :r | (r at: 'Paper Year') asNumber = year ].
						count := rs count: [ :r | (r at: 'Type') ~= 'Design Study' ].
						{year asString.
							count} ]).
	otherData := (otherData labelled: #first)
			background: [ :each | Color orange alpha: 0.75 ].
	scale := GtPlotterLinearScale new domainFrom: 0 to: 45.
	designChart := GtPlotterVerticalBarChart new.
	designChart barHeightScale: scale.
	designChart barWidthScale constant: 28.
	designChart barHeightData: #second.
	designChart amountOfTicks: 9.
	designChart with: designData.
	otherChart := GtPlotterVerticalBarChart new.
	otherChart barHeightScale: scale.
	otherChart barWidthScale constant: 28.
	otherChart barHeightData: #second.
	otherChart amountOfTicks: 9.
	otherChart with: otherData.
	panel := BrFrame new.
	panel layout: BlLinearLayout vertical.
	panel matchParent.
	panel
		addChild: (BrLabel new
				aptitude: BrGlamorousLabelAptitude new;
				text: 'Design Study papers (blue) — yearly count').
	panel addChild: designChart create.
	panel
		addChild: (BrLabel new
				aptitude: BrGlamorousLabelAptitude new;
				text: 'Other paper types (orange) — yearly count').
	panel addChild: otherChart create.
	^ panel
]

{ #category : 'examples' }
VSLoadSnapshot >> clearVSPackage [
	<gtExample>
	<noTest>
	self packageOrganizer
		packageNamed: #VISSOFT
		ifPresent: [ :p | p removeFromSystem ].
	^ Smalltalk packageOrganizer ensurePackage: 'VISSOFT'
]

{ #category : 'helper' }
VSLoadSnapshot >> fileIn: fileOutName [
	self clearVSPackage.
	(self fileOutsFolder / fileOutName) fileIn.
	^ self vsPackage
]

{ #category : 'examples' }
VSLoadSnapshot >> fileOutsFolder [
	<gtExample>
	<noTest>
	^ FileLocator gtResource / 'onierstrasz' / 'gt-vissoft2026' / 'fileOuts'
]

