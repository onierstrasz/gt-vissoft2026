				"paragraphStyle" : {
					"__type" : "textStyle"
				},
				"string" : "Note that to avoid parsing issues, the tutorial uses versions of the CSV files that have beem converted to UTF-8. See {{gtMethod:name=VRTutorialExamples>>#datasetFolder}}. We copy those to our local data folder."
			},
