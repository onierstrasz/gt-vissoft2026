							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "Let's sketch out what we would like it to do ..."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
