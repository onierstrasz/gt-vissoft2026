							"string" : "papersPublishedByYearChart\n\t<gtExample>\n\t<return: #GtPlotterHorizontalBarChart>\n\t| aStudy allPapers selectedDesignStudyPapers years chartData theData maximumCount barChart |\n\taStudy := self study.\n\tallPapers := aStudy allPapers values.\n\tselectedDesignStudyPapers := allPapers select: [ :each | each isDesignStudy and: [ each selectedRecord notNil ] ].\n\tyears := (allPapers collect: [ :each | each record at: #'Paper Year' ]) asSet asSortedCollection.\n\tchartData := years flatCollect: [ :eachYear | \n\t\t| publishedPapers selectedPapers |\n\t\tpublishedPapers := allPapers select: [ :each | (each record at: #'Paper Year') = eachYear ].\n\t\tselectedPapers := selectedDesignStudyPapers select: [ :each | (each record at: #'Paper Year') = eachYear ].\n\t\t{ \n\t\t\t{ #year -> eachYear. #series -> #published. #count -> publishedPapers size. #papers -> publishedPapers } asDictionary.\n\t\t\t{ #year -> eachYear. #series -> #selectedDesignStudy. #count -> selectedPapers size. #papers -> selectedPapers } asDictionary } ].\n\tself assert: ((chartData select: [ :each | (each at: #series) = #published ]) sum: [ :each | each at: #count ]) equals: allPapers size.\n\tself assert: ((chartData select: [ :each | (each at: #series) = #selectedDesignStudy ]) sum: [ :each | each at: #count ]) equals: selectedDesignStudyPapers size.\n\tself assert: (chartData allSatisfy: [ :each | (each at: #papers) size = (each at: #count) ]).\n\ttheData := GtPlotterDataGroup new values: chartData.\n\ttheData := theData\n\t\tgroupedBy: [ :each | each at: #year ]\n\t\tsorted: [ :a :b | a key < b key ]\n\t\tlabelled: #yourself.\n\ttheData := theData\n\t\tgroupedBy: [ :each | each at: #series ]\n\t\tsorted: [ :a :b | a key = #published ]\n\t\tcolored: [ :eachSeries | eachSeries = #published\n\t\t\tifTrue: [ Color r: 173 g: 216 b: 230 range: 255 ]\n\t\t\tifFalse: [ Color r: 255 g: 182 b: 193 range: 255 ] ].\n\tmaximumCount := chartData inject: 0 into: [ :maximum :each | maximum max: (each at: #count) ].\n\tbarChart := GtPlotterHorizontalBarChart new.\n\tbarChart\n\t\twithAdjacentBars;\n\t\tgroupSpacing: 5;\n\t\tbarLabelSpacing: 55;\n\t\tbarStencil: [ :aBar :eachValue :eachGroup | BlElement new\n\t\t\twhen: BlClickEvent do: [ :anEvent |\n\t\t\t\tanEvent consumed: true.\n\t\t\t\tanEvent currentTarget phlow spawnObject: (VSPaperGroup withAll: (eachValue at: #papers)) ] ];\n\t\tbarWidthScale: (GtPlotterLinearScale new domainFrom: 0 to: maximumCount);\n\t\tbarWidthData: [ :each | each at: #count ];\n\t\tbarHeightScale: (GtPlotterLinearScale new domainFrom: 0 to: 2; rangeFrom: 10 to: 24);\n\t\tbarHeightData: [ :eachGroup | eachGroup size ];\n\t\tamountOfTicks: 4;\n\t\twith: theData.\n\t^ barChart"
						}
					]
				},
