										"string" : "papersPublishedAndSelectedDesignStudiesByYearBarChart\n\t<gtExample>\n\t<return: #GtPlotterVerticalBarChart>\n\t| study data published selected maxCount scale chart colors |\n\tstudy := self study.\n\tdata := (2002 to: 2015) flatCollect: [ :year |\n\t\t| papers selectedPapers |\n\t\tpapers := study allPapers values select: [ :paper |\n\t\t\t(paper record at: 'Paper Year') asNumber = year ].\n\t\tselectedPapers := papers select: [ :paper |\n\t\t\tpaper isDesignStudy and: [ paper selectedRecord notNil ] ].\n\t\t{\n\t\t\t{ #year -> year. #kind -> #published. #count -> papers size } asDictionary.\n\t\t\t{ #year -> year. #kind -> #selectedDesignStudies. #count -> selectedPapers size } asDictionary } ].\n\tpublished := (data select: [ :each | (each at: #kind) = #published ]) sumNumbers: [ :each | each at: #count ].\n\tselected := (data select: [ :each | (each at: #kind) = #selectedDesignStudies ]) sumNumbers: [ :each | each at: #count ].\n\tself assert: published equals: study allPapers size.\n\tself assert: selected equals: study selectedPapers size.\n\tcolors := { #published -> Color lightBlue. #selectedDesignStudies -> Color pink } asDictionary.\n\tdata := GtPlotterDataGroup new values: data.\n\tdata := data groupedBy: [ :each | each at: #year ] labelled: [ :year | year asString ].\n\tdata := data groupedBy: [ :each | each at: #kind ] sorted: [ :left :right | left key = #published ] colored: [ :kind | colors at: kind ].\n\tmaxCount := data inject: 0 intoValues: [ :maximum :each | maximum max: (each at: #count) ].\n\tscale := GtPlotterLinearScale new domainFrom: 0 to: maxCount.\n\tchart := GtPlotterVerticalBarChart new.\n\tchart barHeightScale: scale.\n\tchart barWidthScale constant: 16.\n\tchart barHeightData: [ :each | each at: #count ].\n\tchart barLabelSpacing: 35.\n\tchart amountOfTicks: 6.\n\tchart with: data.\n\t^ chart"
									}
								]
