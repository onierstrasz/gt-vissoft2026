									"dateAndTimeString" : "2026-08-26T13:21:09.693833+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693833+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "TQoK6qT1Q6WNFN7giNRAag=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "“Towards Actionable Visualization: Ten Years Later, What Generative AI Changes and What It Cannot.”"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [ ]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693957+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693957+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "urTGWK+rSOW5TOYNkubRqw=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "• GenAI has driven down the cost of producing a visualization toward zero.\n• The cost for humans of interpreting visualizations remains high.\n• Visualization tool sustainability will worsen before it gets better.\n• Studies delivered through immersive environments have grown 15x (but are still a minority).\n• Future research should  focus on helping humans interpret and trust AI-generated visualizations."
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.693978+02:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.693978+02:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "QBLhfWa5TeS9Vmi7ND5v1Q=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "• Surveyed 65 software visualization design studies (journal: 86) focusing on matching visualizations to needs.\n• MetaVis used a catalog to help users find suitable visualizations.\n• Now GenAI makes matching easy. Disposable, bespoke visualizations can be easily generated.\n• The cost of generating a visualization has gone down while the cost of assessing it has risen (do we understand it? do we trust it?).\n• Domains that were neglected (needed but not provided) in 2016 (rationale, contracts, policies) are now tractable through AI.\n• “AI facilitates visualization, but *seeing remains a human act*.”\n• “What it *cannot do* is the rest of the pipeline: using human perceptual and cognitive skills to *recognize the patterns that matter*, and to *judge whether they are genuine* or artifacts of how the data was transformed.”\n• “*Call to Action.* We should treat previously under-served domains (i.e., rationale, contracts, and policies) as priority targets for new design studies now that AI removes their main barrier: the cost of preparing the data. The scarcity that once limited attention to these domains no longer holds.”"
									}
								]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693974+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693974+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "ZPzfGFdtRjGEleXt2bF2/w=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "##*The old paper, neglected domains:*"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.693985+02:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.693985+02:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "+YoMAeNoSQmhI87S8oJEhg=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "• Average lifespan was 3.7 years; only 26% made source code public\n• “Reproducibility is treated as an ethical obligation rather than a rewarded outcome, and prototypes are abandoned accordingly.”\n• “What was a sustainability problem measured in dozens of short-lived research prototypes could scale to millions of ungoverned generated artifacts”\n• “*Call to Action.* Incentives for documentation and maintenance, not just novelty, must be built into how we evaluate and reward research contributions. A tool that is smaller in scope but well-documented and maintained should count as a stronger contribution than a more ambitious one that will not survive its authors’ graduation.”"
									}
								]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693981+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693981+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "KPSpciZNS8i9fbUu1TumiQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "##*Old paper, tool-lifespan:*"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.694008+02:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.694008+02:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "6NZbjBQWSryotxsiQZR7yg=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "• Scanned VISSOFT paper titles from 2017-2025. Immersive 3D/VR/AR titles grew from 1:100 to 1:7 (15x).\n• Building such prototypes has become much cheaper (due to AI?).\n• Smart glasses won't be used as AR but as ambient, glanceable, not immersive. *What should visualizations look like to support developers having a running conversation with a system?* “We cannot yet answer what that visualization should look like, only flag it as the medium shift this survey’s next decade should be watching for.”\n• “*Call to Action.* Medium should become a first-class, explicitly reported dimension of every design study, not an afterthought; the field cannot track a shift it does not consistently measure.”"
									}
								]
							},
							"createEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"createTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693987+02:00"
								}
							},
							"editEmail" : {
								"__type" : "email",
								"emailString" : "<unknown>"
							},
							"editTime" : {
								"__type" : "time",
								"time" : {
									"__type" : "dateAndTime",
									"dateAndTimeString" : "2026-08-26T13:21:09.693987+02:00"
								}
							},
							"uid" : {
								"__type" : "uid",
								"uidString" : "96VM+BX3Sn2Ewvdt6eiKUQ=="
							},
							"paragraphStyle" : {
								"__type" : "textStyle"
							},
							"string" : "##*Old paper, medium:*"
						},
						{
							"__type" : "textSnippet",
							"children" : {
								"__type" : "snippets",
								"items" : [
									{
										"__type" : "textSnippet",
										"children" : {
											"__type" : "snippets",
											"items" : [ ]
										},
										"createEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"createTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.694013+02:00"
											}
										},
										"editEmail" : {
											"__type" : "email",
											"emailString" : "<unknown>"
										},
										"editTime" : {
											"__type" : "time",
											"time" : {
												"__type" : "dateAndTime",
												"dateAndTimeString" : "2026-08-26T13:21:09.694013+02:00"
											}
										},
										"uid" : {
											"__type" : "uid",
											"uidString" : "o9puCHZ8S82Zfn+I5FBN1w=="
										},
										"paragraphStyle" : {
											"__type" : "textStyle"
										},
										"string" : "***A. From technique catalogs to perceptual capacity:***\n• *“We propose that VISSOFT research redirect part of its effort from designing more techniques toward strengthening the human side of the loop, focused on what makes software specifically hard to see.”*\n• *“it is a call to ground perceptual research in the artifacts and questions software uniquely produces”*\n\n***B. From monolithic tools to disposable, continuous seeing:***\n• *“Instead of a small number of task-specific tools, each built to answer one predefined question about one kind of artifact, we expect systems organized around a general capability: continuously examining a system from whatever angle the current question demands. Each view answers the question in front of it, then is abandoned the moment a new one arises, the same shift from artifact to channel, now pushed to its architectural conclusion and already practiced, not merely proposed, in AI-assisted moldable development environments such as Glamorous Toolkit.”*\n• *“it is what a general-purpose model lacks on its own: not the ability to produce code for a chart, but the grounding to know which chart the question calls for”*\n\n***C. A new object of study: visualizing the reasoning of AI itself:***\n• *“We propose that AI-generated code, and the process that generates it, become a first-class object of study for software visualization specifically, one that reveals not only what the code does, but how consistently it can be trusted to mean what it appears to mean.”*\n• *“The distinction that matters here is between AI-assisted coding, where a developer remains the author, reading, editing, and integrating each suggestion, and vibe coding, where the developer specifies intent and accepts output with little line-by-line review.”*\n• *“an agent’s reasoning, its discarded alternatives, its intermediate hypotheses, and the tool calls it made along the way are themselves a data source with no obvious analog in our original 2016 taxonomy.”*"
									}
								]
							},
							"createEmail" : {
