							"code" : "| root files |\nroot := FileLocator imageDirectory / 'dataset-utf8' / 'dataset-utf8'.\nfiles := root allChildren select: [ :each | each isFile and: [ each extension = 'csv' ] ].\nfiles collect: [ :file |\n  | rows headers |\n  rows := CSVParser parseFileWithHeader: file.\n  headers := rows isEmpty ifTrue: [ #() ] ifFalse: [ rows first keys asSortedCollection asArray ].\n  { file basename. file size. rows size. headers } ]"
