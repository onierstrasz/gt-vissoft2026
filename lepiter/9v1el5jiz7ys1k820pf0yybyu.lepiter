							"code" : "| root selected all countValues |\nroot := FileLocator imageDirectory / 'dataset-utf8' / 'dataset-utf8'.\nselected := CSVParser parseFileWithHeader: root / 'dataset-review-vissoft-selected.csv'.\nall := CSVParser parseFileWithHeader: root / 'dataset-review-vissoft-all.csv'.\ncountValues := [ :rows :key | | counts |\n  counts := Dictionary new.\n  rows do: [ :row | | value | value := row at: key ifAbsent: [ nil ]. value ifNotNil: [ counts at: value put: (counts at: value ifAbsent: [ 0 ]) + 1 ] ].\n  (counts associations asSortedCollection: [ :a :b | a value = b value ifTrue: [ a key asString < b key asString ] ifFalse: [ a value > b value ] ]) collect: [ :each | { each key. each value } ] ].\n{ #selectedYears -> (countValues value: selected value: 'Paper Year'). #selectedCategories -> (countValues value: selected value: 'Category'). #selectedTasks -> (countValues value: selected value: 'Task'). #allTypes -> (countValues value: all value: 'Type'). #allYears -> (countValues value: all value: 'Year') }"
